# Copy to .env to override the defaults used by docker-compose.yml.
# These are LOCAL DEVELOPMENT values only — never reuse them anywhere real.

POSTGRES_USER=annotator
POSTGRES_PASSWORD=annotator
POSTGRES_DB=annotator

# S3-compatible object storage (SeaweedFS)
S3_ACCESS_KEY=annotator
S3_SECRET_KEY=annotator-secret
S3_BUCKET=annotations

# Maximum size of one uploaded image, in MB
MAX_UPLOAD_MB=20
